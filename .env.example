# Papertown reads these from the environment; nothing here is loaded automatically.
# Agents use the installed CLI's own login. Papertown holds no model or embedding key.
# Install Claude Code, Codex or Antigravity and use Paseo, herdr or tmux as the runtime.

# Storage and integrations.
# PAPERTOWN_DATA_DIR=server/var
# PAPERTOWN_SKILLS_DIR=server/skills
# PAPERTOWN_ARXIV=1                  # 0 turns off the arXiv dock
# PAPERTOWN_MCP_CONFIG=              # JSON file, {"mcpServers": {...}}
# PAPERTOWN_COMPILE_TEX=1            # 0 skips latexmk
# PAPERTOWN_PRICES=                  # JSON price overrides per model
# S2_API_KEY=

# pi agents in the press and the depot (they use pi's own model settings and login).
# PAPERTOWN_PI_BIN=
# PAPERTOWN_PI_MODEL=
# PAPERTOWN_TMUX_BIN=
# Agents in Paseo (paseo.sh): the CLI (default: on PATH or inside /Applications/Paseo.app),
# the web app the rooms embed, and an explicit daemon endpoint (default: the local daemon)
# PAPERTOWN_PASEO_BIN=
# PAPERTOWN_PASEO_URL=http://127.0.0.1:6767
# PAPERTOWN_PASEO_HOST=
# PAPERTOWN_HERDR=1                 # 0 turns off terminal integration
# PAPERTOWN_HERDR_SOCKET=~/.config/herdr/herdr.sock
# Employees that run Claude Code, Codex or Antigravity in a herdr tab or a tmux window: where each CLI
# is (default: on PATH, skipping other apps' wrapper scripts), the tmux server shared with pi, the
# runtime new task agents and leads use (paseo, herdr or tmux, also set in the settings page), and
# how many seconds of a still screen mean a working agent waits on a dialog, a start is held by one,
# and an agent sent Esc has stopped.
# PAPERTOWN_CLAUDE_BIN=
# PAPERTOWN_CODEX_BIN=
# PAPERTOWN_AGY_BIN=
# PAPERTOWN_TMUX_SOCKET=papertown
# PAPERTOWN_AGENT_RUNTIME=paseo
# PAPERTOWN_TERMINAL_STILL=15
# PAPERTOWN_TERMINAL_READY=5
# PAPERTOWN_TERMINAL_SETTLE=2
# The employees page shows a terminal employee's conversation by reading the CLI's own session log
# (found by session id under the homes below, nothing is stored). 0 shows the terminal screen only.
# PAPERTOWN_TRANSCRIPTS=1
# What the assistant, resident leads and workers start on until one is chosen in
# the settings page (provider/model@thinking), how often Paseo's model list is read for new models
# (seconds, 0 turns it off), how often the leads' check-ins are looked at (seconds), and the least
# time between two check-ins for one lead
# PAPERTOWN_ASSISTANT_MODEL=codex/gpt-6.1-terra@xhigh
# PAPERTOWN_LEAD_MODEL=codex/gpt-6.1-terra@high
# PAPERTOWN_WORKER_MODEL=           # empty follows the lead default
# PAPERTOWN_LEAD_RESIDENT=1         # 0 disables automatic lead startup for tests/diagnosis
# PAPERTOWN_PASEO_WATCH=1800
# PAPERTOWN_LEAD_TICK=20
# PAPERTOWN_LEAD_GAP=180
# PAPERTOWN_LOCAL_JOBS=2
# Prebuilt samples: five projects at different stages, with lead switches off, on the first empty start.
# PAPERTOWN_SAMPLES=1              # 0 disables automatic seeding

# nvidb (the GPU queue on your own machines), read only: the GPUs on the farm and at the power plant.
# PAPERTOWN_NVIDB=1                  # 0 turns it off
# PAPERTOWN_NVIDB_BIN=               # default: nvidb on PATH
# Your own projects, linked in from local code and LaTeX repos; the file stays on this machine.
# PAPERTOWN_PROJECTS=                # default: projects.json in the data dir
# Where "import memory" and the usage statistics look for agent session logs on this machine.
# PAPERTOWN_CLAUDE_HOME=~/.claude
# PAPERTOWN_CODEX_HOME=~/.codex
# PAPERTOWN_ANTIGRAVITY_HOME=~/.gemini/antigravity-cli
# Subscription usage: how often to read it (seconds), and whether to count tokens from the logs above.
# PAPERTOWN_USAGE_POLL=300
# PAPERTOWN_USAGE_LOGS=1             # 0 shows subscription quotas only
# skim (github.com/FanBB2333/skim): skills layered per project and conversation in the skill academy.
# PAPERTOWN_SKIM_BIN=                # default: skim on PATH
