# Papertown's settings live in papertown.toml at the root of the checkout: copy papertown.example.toml,
# which lists every setting with its default, and change what you need (`papertown config show` prints
# what is in effect). Any of them can also be set here as an environment variable PAPERTOWN_<NAME>, which
# wins over the file; nothing in this file is loaded automatically.
#
# Keep secrets out of papertown.toml and the repository: put them in your shell's environment.
# S2_API_KEY=                        # Semantic Scholar, optional ([services] s2_key)
