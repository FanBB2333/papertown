# Papertown reads these from the environment; nothing here is loaded automatically.
# Put real keys in ~/.secrets.zsh (or Keychain) and export them, never in this repo.

# Provider: leave every key empty to run offline with the scripted provider.
# ANTHROPIC_API_KEY=
# PAPERTOWN_OPENAI_API_KEY=
# PAPERTOWN_OPENAI_BASE_URL=https://api.deepseek.com
# PAPERTOWN_PROVIDER=mock            # anthropic | openai | mock
# PAPERTOWN_MODEL_STRONG=claude-opus-5-5
# PAPERTOWN_MODEL_CHEAP=claude-haiku-5-5
# PAPERTOWN_EFFORT=medium

# Optional OpenAI-compatible embeddings for the library.
# PAPERTOWN_EMBED_BASE_URL=
# PAPERTOWN_EMBED_API_KEY=
# PAPERTOWN_EMBED_MODEL=

# Budgets in USD.
# PAPERTOWN_WEEKLY_BUDGET=10
# PAPERTOWN_LINE_BUDGET=1.0

# Storage and integrations.
# PAPERTOWN_DATA_DIR=server/var
# PAPERTOWN_SKILLS_DIR=server/skills
# PAPERTOWN_ARXIV=1                  # 0 turns off the arXiv dock
# PAPERTOWN_MCP_CONFIG=              # JSON file, {"mcpServers": {...}}
# PAPERTOWN_SIM_GPU_SECONDS=6
# PAPERTOWN_COMPILE_TEX=1            # 0 skips latexmk
# PAPERTOWN_PRICES=                  # JSON price overrides per model
# S2_API_KEY=

# pi agents in the press and the depot (they use pi's own model settings and login).
# PAPERTOWN_PI_BIN=
# PAPERTOWN_PI_MODEL=
# PAPERTOWN_TMUX_BIN=
# Agents in Paseo (paseo.sh): the CLI (default: on PATH or inside /Applications/Paseo.app),
# the web app the rooms embed, and an explicit daemon endpoint (default: the local daemon)
# PAPERTOWN_PASEO_BIN=
# PAPERTOWN_PASEO_URL=http://127.0.0.1:6767
# PAPERTOWN_PASEO_HOST=
# What the console's assistant and each project's lead start on in Paseo unless another is picked
# (provider/model@thinking), how often the leads' check-ins are looked at (seconds), and the
# least time between two check-ins for one lead
# PAPERTOWN_ASSISTANT_MODEL=codex/gpt-6.1-terra@xhigh
# PAPERTOWN_LEAD_MODEL=codex/gpt-6.1-terra@high
# PAPERTOWN_LEAD_TICK=20
# PAPERTOWN_LEAD_GAP=180
# PAPERTOWN_LOCAL_JOBS=2
# offline demo: put five sample projects on the lines the first time the town starts empty (0 turns it off)
# PAPERTOWN_SAMPLES=1

# nvidb (the GPU queue on your own machines), read only: the GPUs on the farm and at the power plant.
# PAPERTOWN_NVIDB=1                  # 0 turns it off
# PAPERTOWN_NVIDB_BIN=               # default: nvidb on PATH
# Your own projects, linked in from local code and LaTeX repos; the file stays on this machine.
# PAPERTOWN_PROJECTS=                # default: projects.json in the data dir
# skim (github.com/FanBB2333/skim): skills layered per project and conversation in the skill academy.
# PAPERTOWN_SKIM_BIN=                # default: skim on PATH
