{"decisions":[{"id":"dc_5d57984f9e","n":8,"mod":"exp","text":"在抓取前和放置后分别施加遮挡，完整方法及各基线使用相同轨迹和三个种子。单列回退消融。","source":"written","ref":null,"state":"active","replaces":"dc_aa1a291faa","materials":[],"matter":null,"created_at":"2026-11-25T17:29:36+00:00","ended_at":null,"replaced_by":null,"counts":{"jobs":0,"outputs":0,"tells":0,"tasks":0,"prov":0}},{"id":"dc_538d948377","n":7,"mod":"agents","text":"代码员工实现状态记录和回退重放，写作员工核对每个轨迹图里的子目标时间。","source":"written","ref":null,"state":"active","replaces":null,"materials":[],"matter":null,"created_at":"2026-11-25T17:29:36+00:00","ended_at":null,"replaced_by":null,"counts":{"jobs":0,"outputs":0,"tells":0,"tasks":0,"prov":0}},{"id":"dc_e3b5a59253","n":6,"mod":"paper","text":"先用一次物体被移走的轨迹解释回退条件，再分开呈现长程成功率和扰动恢复率。","source":"written","ref":null,"state":"active","replaces":null,"materials":[],"matter":null,"created_at":"2026-11-25T17:29:36+00:00","ended_at":null,"replaced_by":null,"counts":{"jobs":0,"outputs":0,"tells":0,"tasks":0,"prov":0}},{"id":"dc_b347955276","n":5,"mod":"data","text":"同一场景的轨迹只属于一个集合。记录整段成功率、完成子目标的比例和扰动后的恢复率。","source":"written","ref":null,"state":"active","replaces":null,"materials":[],"matter":null,"created_at":"2026-11-25T17:29:36+00:00","ended_at":null,"replaced_by":null,"counts":{"jobs":0,"outputs":1,"tells":0,"tasks":0,"prov":0}},{"id":"dc_aa1a291faa","n":4,"mod":"exp","text":"每个任务只在初始状态加入遮挡。","source":"written","ref":null,"state":"replaced","replaces":null,"materials":[],"matter":null,"created_at":"2026-11-25T17:29:36+00:00","ended_at":"2026-11-25T17:29:36+00:00","replaced_by":"dc_5d57984f9e","counts":{"jobs":0,"outputs":0,"tells":0,"tasks":0,"prov":0}},{"id":"dc_9e951a85be","n":3,"mod":"code","text":"每次抓放后更新物体关系，子目标失败时回到最近一次满足前置条件的图状态。","source":"written","ref":null,"state":"active","replaces":null,"materials":[],"matter":null,"created_at":"2026-11-25T17:29:36+00:00","ended_at":null,"replaced_by":null,"counts":{"jobs":0,"outputs":1,"tells":0,"tasks":0,"prov":0}},{"id":"dc_68e29b7bf3","n":2,"mod":"survey","text":"用 Reactive policy、Static scene graph、Replan without rollback 作对照。逐组核对输入条件与评测预算。","source":"written","ref":null,"state":"active","replaces":null,"materials":[{"kind":"paper","ref":"arxiv:2610.05230","title":"Vela: Scaling Vision-Language-Action Models with Adaptive Action Curve Parametrization"}],"matter":null,"created_at":"2026-11-25T17:29:36+00:00","ended_at":null,"replaced_by":null,"counts":{"jobs":0,"outputs":1,"tells":0,"tasks":0,"prov":0}},{"id":"dc_fdbeff5b50","n":1,"mod":"overview","text":"机器人长程操作：用场景图记录物体关系和状态变化，视觉语言动作模型按子目标执行，失败时沿场景图回退重新规划，减少多步任务里的误差累积","source":"idea","ref":null,"state":"active","replaces":null,"materials":[],"matter":null,"created_at":"2026-11-25T17:29:36+00:00","ended_at":null,"replaced_by":null,"counts":{"jobs":0,"outputs":2,"tells":0,"tasks":0,"prov":0}}],"matters":[{"id":8,"agent":"lead-line_4","who":"项目负责人","question":"连续两次回退都失败的轨迹，应在哪一步结束评测？","mod":"exp","facts":["现有方法草案记录每次回退前后的场景图。","恢复率按整段轨迹计分，目前未设专门的回退次数上限。"],"options":["按统一的总步数结束","达到两次回退后停止并记录失败"],"materials":[{"kind":"paper","ref":"arxiv:2610.05230","title":"Vela: Scaling Vision-Language-Action Models with Adaptive Action Curve Parametrization"}],"since":"2026-11-25T17:29:36+00:00"}],"loose":[],"stats":{"total":8,"active":7,"anchored":2,"loose":0},"mods":[{"id":"overview","name":"概览"},{"id":"survey","name":"调研"},{"id":"code","name":"代码仓库"},{"id":"exp","name":"实验"},{"id":"data","name":"数据"},{"id":"paper","name":"论文"},{"id":"agents","name":"员工"}]}